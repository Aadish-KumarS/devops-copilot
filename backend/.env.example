# Optional: enables Gemini-powered investigation; the deterministic fallback keeps the demo working without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: GitHub fine-grained token for private repositories and a higher API rate limit.
# Grant read-only access to Contents/Metadata only. Never expose this value to the Vite frontend.
GITHUB_TOKEN=
